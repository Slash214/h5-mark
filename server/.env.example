# ---------- 服务 ----------
PORT=3000
NODE_ENV=production
# JWT 密钥，务必改成随机字符串（基础设施，不进后台）
JWT_SECRET=please-change-me-to-a-random-string
JWT_EXPIRES=7d

# ---------- MySQL（每个客户可指向不同库） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=h5_mark

# ---------- 微信 / 支付（可选兜底） ----------
# 推荐在管理后台「系统配置 → 微信支付」填写；后台为空时才读这里
SITE_URL=
WX_APPID=
WX_APPSECRET=
WXPAY_MCHID=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
WXPAY_API_V3_KEY=
WXPAY_NOTIFY_URL=

# ---------- 开发调试（线上必须 0） ----------
DEV_FAKE_LOGIN=0
MOCK_OPENID=o_dev_mock_openid_0001
DEV_FAKE_PAY=0
