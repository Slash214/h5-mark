# ---------- 服务 ----------
PORT=3000
NODE_ENV=production
# H5 前端访问地址（用于微信授权回跳、支付回调拼接）
SITE_URL=https://haoma.example.com
# JWT 密钥，务必改成随机字符串
JWT_SECRET=please-change-me-to-a-random-string
JWT_EXPIRES=7d

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=h5_mark

# ---------- 微信公众号（服务号） ----------
WX_APPID=wx0000000000000000
WX_APPSECRET=
# 公众号 token（如需接入消息服务器）
WX_TOKEN=

# ---------- 微信支付 V3（JSAPI） ----------
WXPAY_MCHID=1600000000
# 商户 API 证书序列号
WXPAY_SERIAL_NO=
# 商户私钥 apiclient_key.pem 的路径（相对 server 目录或绝对路径）
WXPAY_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
# APIv3 密钥（32 位）
WXPAY_API_V3_KEY=
# 支付回调地址，必须是 https 且外网可访问
WXPAY_NOTIFY_URL=https://haoma.example.com/api/pay/notify

# ---------- 开发调试 ----------
# 1 = 跳过微信授权，使用 MOCK_OPENID 直接登录（仅本地联调用，线上必须 0）
DEV_FAKE_LOGIN=0
MOCK_OPENID=o_dev_mock_openid_0001
# 1 = 不真正调用微信支付，下单后直接标记为已支付（仅本地联调）
DEV_FAKE_PAY=0
